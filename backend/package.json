{
  "name": "backend",
  "version": "1.0.0",
  "main": "api/app.ts",
  "scripts": {
    "format": "npx prettier --write . && npx prisma format",
    "format-check": "npx prettier --check .",
    "db:start": "docker run --name summer-postgres -p 5432:5432 -e POSTGRES_PASSWORD=summer -d postgres",
    "generate": "prisma generate",
    "dev": "prisma generate && nodemon --exec ts-node ./api/app.ts",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap": "ts-node ./src/seed/bootstrap.ts",
    "seed:dummy": "ts-node ./src/seed/dummy.ts",
    "beta:generate-import": "ts-node ./src/seed/generateBetaImportFromRawSchedule.ts",
    "prisma:init": "prisma generate && npx prisma migrate reset --force && npm run db:bootstrap",
    "fixture:generate:normalized-import": "ts-node ./src/seed/generateNormalizedImportFixture.ts",
    "fixture:generate:incremental-import": "ts-node ./src/seed/generateIncrementalImportFixture.ts",
    "test": "prisma generate && vitest run src/test/api",
    "test:api": "prisma generate && vitest run src/test/api",
    "test:performance": "prisma generate && vitest run src/test/performance",
    "build": "cd ../shared && npm install && cd ../backend && prisma generate && npm run db:migrate && npm run db:bootstrap",
    "lint:unused": "knip"
  },
  "engines": {
    "node": "20.x || ^22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@testcontainers/postgresql": "^11.7.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.6",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "knip": "^5.64.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.2",
    "prisma": "^7.2.0",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.2.0",
    "@vercel/blob": "^1.1.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^6.0.11",
    "jszip": "^3.10.1",
    "multer": "^2.0.1",
    "resend": "^4.1.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "zod": "4.1.11"
  }
}
